# Example environment values for local development. Copy this file to `.env` (gitignored) to
# get started — these values match the local Docker services in docker-compose.yml, so they
# work as-is for local dev; no real secrets here.
# DEVIATION: MinIO stands in for Cloudflare R2 for now (no payment method available yet).
# Storage code is written generically against any S3-compatible endpoint, so swapping
# these values for real Cloudflare R2 later requires no code change.

# --- Postgres (pgvector) ---
ConnectionStrings__WriteDb=Host=localhost;Port=5432;Database=storporate-dev;Username=storporate;Password=storporate
# SSL negotiation mode for the Postgres connection (Npgsql SslMode: Disable/Allow/Prefer/Require/
# VerifyCA/VerifyFull). "Prefer" is a no-op against today's local non-TLS Docker Postgres
# container (Npgsql negotiates plaintext when the server doesn't support SSL). Becomes a real
# enforcement point (e.g. "Require" or "VerifyFull") once pointed at a hosted Postgres later.
ConnectionStrings__SslMode=Prefer

# --- Artifact Storage (MinIO for now, Cloudflare R2 later) ---
# Shape is provider-agnostic (Provider/Endpoint/BucketName/AccessKey/SecretKey) per the
# Phase 2 Options-pattern contract, so swapping to real Cloudflare R2 later only means
# changing these values, never the code that binds them.
ArtifactStorage__Provider=MinIO
ArtifactStorage__Endpoint=http://localhost:9000
ArtifactStorage__AccessKey=storporate-minio
ArtifactStorage__SecretKey=storporate-minio-secret
ArtifactStorage__BucketName=storporate-dev-evidence

# --- Bionic local LLM server (CONFIRMED Phase 1, 2026-09-12) ---
Llm__Bionic__BaseUrl=http://localhost:1234/v1
Llm__Bionic__ModelId=google/gemma-4-12b-qat

# --- Field-level encryption (AesGcmFieldEncryptor; Phase 2) ---
# Must be a base64-encoded 32-byte (AES-256) key. Generate your own local-dev value with:
#   openssl rand -base64 32
# Not a real secret below — replace it before running the API.
Encryption__FieldEncryptionKey=REPLACE_WITH_OUTPUT_OF_openssl_rand_-base64_32
